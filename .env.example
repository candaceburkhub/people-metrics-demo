# Everything runs on synthetic data with no configuration.
# These variables show what changes when you point the same code at real systems.

# "mock" (default) routes every call to the in-repo mock APIs.
# "live" uses real HTTP against the base URLs below.
DATA_MODE=mock

# Rippling platform API. Token comes from an admin (may need a plan add-on) or an approved app.
# Verify the base path and field names against developer.rippling.com before going live.
RIPPLING_BASE_URL=https://api.rippling.com/platform/api
RIPPLING_API_TOKEN=

# Ashby API. Basic auth, API key as the username and an empty password.
ASHBY_BASE_URL=https://api.ashbyhq.com
ASHBY_API_KEY=

# Non-Rippling sources (survey, performance, LMS, finance). Replace with real connectors.
OPS_BASE_URL=
OPS_API_TOKEN=

# MCP bearer tokens. A request with no token gets the least-privileged (leadership) scope.
MCP_HR_TOKEN=change-me-hr
MCP_LEADERSHIP_TOKEN=change-me-leadership

# Retry backoff base in milliseconds for the API clients.
PIPELINE_BACKOFF_MS=400

# Set to 1 to make the mock APIs fail every few requests (429 and 503) so retries are visible.
MOCK_CHAOS=0
